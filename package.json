{
  "name": "gac-helper-dev",
  "private": true,
  "version": "1.0.0",
  "description": "SWGOH GAC Helper development repository test and check commands.",
  "scripts": {
    "test": "node --test",
    "check": "for f in app.js service-worker.js workers/*.mjs scripts/*.js tests/*.js; do node --check \"$f\" || exit 1; done",
    "baseline:verify": "node scripts/verify-baseline.js",
    "db:test": "node --test tests/database-schema.test.js tests/migration-loader.test.js tests/authoring-loader.test.js",
    "migrate:reconcile": "node scripts/migration-reconcile.js",
    "migrate:load": "node scripts/migration-load.js",
    "migrate:verify": "node scripts/migration-verify.js",
    "author:validate": "node scripts/authoring-validate.js",
    "author:dry-run": "node scripts/authoring-dry-run.js",
    "author:apply": "node scripts/authoring-load.js",
    "catalogue:generate": "node scripts/catalogue-publish.js generate",
    "catalogue:validate": "node scripts/catalogue-publish.js validate",
    "catalogue:prepare": "node scripts/catalogue-publish.js prepare",
    "catalogue:stage": "node scripts/catalogue-publish.js stage",
    "catalogue:deploy": "node scripts/catalogue-publish.js deploy",
    "catalogue:verify": "node scripts/catalogue-publish.js verify",
    "catalogue:finalise": "node scripts/catalogue-publish.js finalise",
    "catalogue:reconcile": "node scripts/catalogue-publish.js reconcile",
    "catalogue:rollback": "node scripts/catalogue-publish.js rollback",
    "catalogue:publish": "node scripts/catalogue-publish.js publish",
    "build:worker": "node scripts/build-worker-assets.js",
    "deploy:development": "npm run build:worker && wrangler deploy",
    "deploy:production": "npm run build:worker && wrangler deploy --env production",
    "rollback:development": "wrangler rollback",
    "rollback:production": "wrangler rollback --env production"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "wrangler": "4.136.0"
  },
  "dependencies": {
    "postgres": "3.4.9"
  }
}
