{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gac-helper-dev",
  "main": "./workers/static-assets.mjs",
  "compatibility_date": "2026-08-30",
  "vars": {
    "NOINDEX": "true"
  },
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "env": {
    "production": {
      "name": "gac-helper",
      "vars": {
        "NOINDEX": "false"
      }
    }
  }
}
